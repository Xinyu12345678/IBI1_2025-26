#define a function to calculate protein mass
#import the weight of amino acid into a dictionary
#setup a variable to store the mass
#calculate the sum of amino acid mass in a sequence
#break when a n amino acid is not in the dic
#return the results
def protein_mass(amino_acid_sequence):
    '''Calculate the mass of a protein given its amino acid sequence.'''
    amino_acid_mass={"G":57.02,"A":71.04,"S":87.03,
                     "P":97.05,"V":99.07,"T":101.05,
                     "C":103.01,"I":113.08,"L":113.08,
                     "N":114.04,"D":115.03,"Q":128.06,
                     "K":128.09,"E":129.04,"M":131.04,
                     "H":137.06,"F":147.07,"R":156.10,
                     "Y":163.06,"W":186.08}
    total_mass=0
    for aa in amino_acid_sequence:
        if aa in amino_acid_mass:
            total_mass+=amino_acid_mass[aa]
        else:
            print(f"{aa} has not recorded mass")
            return 
    return total_mass
#Example of how this function should be called
sequence="AHCD"
print(protein_mass(sequence),"amu")