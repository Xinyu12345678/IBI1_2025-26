#import necessary libraries
#define basic variables 
#create arrays to store the value
import numpy as np
import matplotlib.pyplot as plt
I=1
S=9999
N=10000
R=0
beta=0.3
gamma=0.05
infected_all=[I]
susceptible_all=[S]
recovered_all=[R]

#For each time step: 
#infect susceptible individuals
#Recover infected individuals
#update and record S,I, and R
for i in range(1000):
    new_infected=sum(np.random.choice(range(2),S,p=[1-I*beta/N,I*beta/N]))
    new_recovered=sum(np.random.choice(range(2),I,p=[1-gamma,gamma]))
    I=I+new_infected-new_recovered
    R+=new_recovered
    S=S-new_infected
    infected_all.append(int(I))
    susceptible_all.append(int(S))
    recovered_all.append(int(R))

#plot the results
plt.figure(figsize=(6,4),dpi=150)
plt.plot(infected_all,label="infected")
plt.plot(susceptible_all,label="susceptible")
plt.plot(recovered_all,label="recovered")
plt.xlabel("time")
plt.ylabel("number of people")
plt.title("SIR model")
plt.legend(loc="upper right")
plt.savefig("D:/git/IBI/class_material/IBI_2025-26/IBI1_2025-26/Practical_9/SIR_model.png")
plt.show()